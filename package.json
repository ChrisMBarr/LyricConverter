{
  "name": "lyric-converter",
  "version": "3.3.11",
  "homepage": "https://lyricconverter.net",
  "author": {
    "name": "Chris Barr",
    "url": "http://chrisbarr.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChrisMBarr/LyricConverter"
  },
  "bugs": {
    "url": "https://github.com/ChrisMBarr/LyricConverter/issues"
  },
  "scripts": {
    "ng": "npm run genversion && ng",
    "start": "npm run genversion && ng serve",
    "build": "npm run genversion && ng build",
    "genversion": "npx genversion src/app/version.ts --es6 --semi",
    "watch": "npm run genversion && ng build --watch --configuration development",
    "test": "npm run genversion && ng test",
    "test-browsers-all": "npm run genversion && ng test --browsers=Edge,Firefox,Chrome",
    "test-browser-firefox": "npm run genversion && ng test --browsers=Firefox",
    "test-browser-edge": "npm run genversion && ng test --browsers=Edge",
    "test-coverage": "npm run genversion && ng test --code-coverage --no-watch",
    "test-coverage-headless": "npm run genversion && ng test --code-coverage --no-watch --browsers=ChromeHeadless",
    "lint": "ng lint --fix",
    "update": "npm run update-angular && npx npm-check-updates -u",
    "update-angular": "ng update @angular/cli @angular/core @angular-eslint/schematics --allow-dirty",
    "serve:ssr:LyricConverter": "node dist/LyricConverter/server/server.mjs"
  },
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/platform-browser": "^21.2.11",
    "@angular/platform-browser-dynamic": "^21.2.11",
    "@angular/platform-server": "^21.2.11",
    "@angular/router": "^21.2.11",
    "@angular/ssr": "21.2.9",
    "@types/mime-types": "^3.0.1",
    "buffer": "^6.0.3",
    "chordsheetjs": "^14.5.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "globals": "^17.6.0",
    "js-base64": "^3.7.8",
    "jszip": "^3.10.1",
    "mime-types": "^3.0.2",
    "openlyrics-parser": "^1.1.9",
    "propresenter-parser": "^1.0.6",
    "rxjs": "^7.8.2",
    "songpro": "^0.1.2",
    "songshowplus-parser": "^2.0.6",
    "timers-browserify": "^2.0.12",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2102.9",
    "@angular-devkit/core": "^21.2.9",
    "@angular-eslint/builder": "~21.3.1",
    "@angular-eslint/eslint-plugin": "~21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "~21.3.1",
    "@angular-eslint/template-parser": "~21.3.1",
    "@angular/build": "^21.2.9",
    "@angular/cli": "21.2.9",
    "@angular/compiler-cli": "^21.2.11",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/file-saver": "~2.0.7",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "angular-eslint": "^21.3.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "genversion": "^3.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.13",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "3.0.24",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
